# Copiar a .env (gitignored) y completar con valores reales antes de
# levantar con docker-compose. Ver CLAUDE.md, sección "Autenticación" para
# los valores reales de Cognito del proyecto, y "Contacto por correo en el
# MVP" para el proveedor de correo.

MYSQL_ROOT_PASSWORD=changeme
DB_USER=alertas_user
DB_PASSWORD=changeme

# Cuenta de Gmail dedicada + contraseña de aplicación (no la clave normal
# de la cuenta). "contacto.remitente" toma este mismo valor por defecto.
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=your-app-password

COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
