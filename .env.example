# Plantilla: copia este archivo a .env y completa los valores. .env NO se versiona.

# SMTP (Gmail con "Contrasena de aplicacion", no la clave de la cuenta)
MAIL_USERNAME=
MAIL_PASSWORD=

# Cognito (User Pool del entorno)
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# MySQL de desarrollo (docker-compose crea el usuario y la app se conecta con el mismo)
DB_USER=
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Secreto compartido con ms-mascotas y ms-chat para /internal/** (header X-Internal-Token).
# Minimo 32 caracteres y el MISMO valor en los tres servicios. Genera uno con: openssl rand -base64 48
INTERNAL_API_TOKEN=
